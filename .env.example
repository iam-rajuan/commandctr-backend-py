NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
TRUST_PROXY=1
MONGODB_URI=mongodb://127.0.0.1:27017/twinstr
MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8
JWT_ACCESS_SECRET=replace-with-access-secret
JWT_REFRESH_SECRET=replace-with-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOG_LEVEL=info
AWS_REGION=us-east-1
AWS_S3_BUCKET=replace-with-bucket
AWS_ACCESS_KEY_ID=replace-with-access-key
AWS_SECRET_ACCESS_KEY=replace-with-secret-key
RESEND_API_KEY=replace-with-resend-key
RESEND_FROM_EMAIL=no-reply@example.com
SHOPIFY_SHOP_DOMAIN=your-shop.myshopify.com
SHOPIFY_API_VERSION=2026-04
SHOPIFY_CLIENT_ID=replace-with-shopify-client-id
SHOPIFY_CLIENT_SECRET=replace-with-shopify-client-secret
SHOPIFY_APP_URL=http://localhost:5000
SHOPIFY_REDIRECT_URI=http://localhost:5000/api/v1/shopify/callback
SHOPIFY_ADMIN_ACCESS_TOKEN=replace-with-shopify-admin-token
EBAY_ENVIRONMENT=sandbox
EBAY_CLIENT_ID=replace-with-ebay-client-id
EBAY_CLIENT_SECRET=replace-with-ebay-client-secret
EBAY_RU_NAME=replace-with-ebay-ru-name
EBAY_REDIRECT_URI=http://localhost:5000/api/v1/ebay/callback
EBAY_SCOPES=https://api.ebay.com/oauth/api_scope/sell.account.readonly
EBAY_API_BASE_URL=https://api.sandbox.ebay.com
EBAY_MARKETPLACE_ID=EBAY_GB
EBAY_MERCHANT_LOCATION_KEY=replace-with-location-key
EBAY_PAYMENT_POLICY_ID=replace-with-payment-policy-id
EBAY_RETURN_POLICY_ID=replace-with-return-policy-id
EBAY_FULFILLMENT_POLICY_ID=replace-with-fulfillment-policy-id
EBAY_DEFAULT_CATEGORY_ID=replace-with-category-id
EBAY_DEFAULT_CURRENCY=GBP
EBAY_LISTING_FORMAT=FIXED_PRICE
EBAY_LISTING_DURATION=GTC
EBAY_DEFAULT_CONDITION=NEW
EBAY_SANDBOX_CLIENT_ID=replace-with-ebay-sandbox-client-id
EBAY_SANDBOX_CLIENT_SECRET=replace-with-ebay-sandbox-client-secret
EBAY_SANDBOX_RU_NAME=replace-with-ebay-sandbox-ru-name
EBAY_SANDBOX_REDIRECT_URI=http://localhost:5000/api/v1/ebay/callback
EBAY_SANDBOX_AUTH_URL=https://auth.sandbox.ebay.com/oauth2/authorize
EBAY_SANDBOX_TOKEN_URL=https://api.sandbox.ebay.com/identity/v1/oauth2/token
EBAY_PRODUCTION_CLIENT_ID=replace-with-ebay-production-client-id
EBAY_PRODUCTION_CLIENT_SECRET=replace-with-ebay-production-client-secret
EBAY_PRODUCTION_RU_NAME=replace-with-ebay-production-ru-name
EBAY_PRODUCTION_REDIRECT_URI=https://api.example.com/api/v1/ebay/callback
EBAY_PRODUCTION_AUTH_URL=https://auth.ebay.com/oauth2/authorize
EBAY_PRODUCTION_TOKEN_URL=https://api.ebay.com/identity/v1/oauth2/token
ETSY_CLIENT_ID=replace-with-etsy-client-id
ETSY_REDIRECT_URI=http://localhost:5000/api/v1/etsy/callback
ETSY_SCOPES=shops_r
ETSY_AUTH_URL=https://www.etsy.com/oauth/connect
ETSY_TOKEN_URL=https://api.etsy.com/v3/public/oauth/token
ETSY_API_BASE_URL=https://api.etsy.com/v3/application
ETSY_SHARED_SECRET=replace-with-etsy-shared-secret
FRONTEND_URL=http://localhost:3001
ENCRYPTION_SECRET=replace-with-32-character-minimum-secret
